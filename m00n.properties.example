# M00N Reporter Configuration
# Copy this file to m00n.properties and fill in your values

# Enable/disable reporter (set to false for local development)
m00n.enabled=true

# Required: M00N Report ingest server URL
m00n.serverUrl=http://localhost:4001

# Required: Project API key (get from M00N Report dashboard)
m00n.apiKey=m00n_your_api_key_here

# Optional: Run/launch name
m00n.launch=Playwright Java Tests

# Optional: Tags (comma-separated)
m00n.tags=smoke,regression

# Optional: Debug mode (true/false)
m00n.debug=false

# Optional: HTTP timeout in milliseconds
m00n.timeout=30000

# Optional: Max retry attempts
m00n.maxRetries=3

# Optional: Custom attributes (prefix with m00n.attribute.)
m00n.attribute.environment=staging
m00n.attribute.browser=chromium
m00n.attribute.ci=false

# Recognized by the M00N dashboard - shown on each launch card.
# ${env.VAR} is substituted from the environment when the file is read, so a CI
# job can fill these in without a build script. If the variable is not set the
# attribute is simply omitted, never sent as the literal placeholder.
m00n.attribute.branch=${env.GITHUB_REF_NAME}
m00n.attribute.triggered_by=${env.GITHUB_ACTOR}

# Or skip the file entirely. Any M00N_ATTRIBUTE_<NAME> variable becomes the
# attribute <name>, which is usually the least ceremony in CI:
#   M00N_ATTRIBUTE_BRANCH=$CI_COMMIT_REF_NAME
#   M00N_ATTRIBUTE_TRIGGERED_BY=$GITLAB_USER_LOGIN
# Priority is the same as every other setting: -D system property, then the
# environment, then this file.
